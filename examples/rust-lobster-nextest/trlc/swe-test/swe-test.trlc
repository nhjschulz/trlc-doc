package SwTests

import Generic
import SwRequirements

section "SW Tests" {

    Generic.Info sw_test_info_about_sw_test {
        description = "This file contains the software test cases for the Greeter tool. They are implemented as Rust unit tests in the tests module of each source file."
    }

    section "General" {

        SwTestCase tc_cli {
            description = "This test case checks that the tool runs with a user name argument (app::tests::cli)."
            verifies = [SwRequirements.sw_req_cli]
        }

        SwTestCase tc_cli_stdout {
            description = "This test case checks that the greeting is written to the standard output, and nothing to the standard error (app::tests::cli_stdout)."
            verifies = [SwRequirements.sw_func_msg_output]
        }

        SwTestCase tc_cli_usage_help {
            description = "This test case checks that the -h and --help arguments show the usage (app::tests::cli_usage_help)."
            verifies = [SwRequirements.sw_req_cli_help]
        }

        SwTestCase tc_cli_usage_error {
            description = "This test case checks that an unknown option and a second name are reported as usage error on the standard error (app::tests::cli_usage_error)."
            verifies = [SwRequirements.sw_req_cli_usage_error]
        }
    }

    section "Greeter Functionality" {
        SwTestCase tc_func_daytime_greeting_selection {
            description = "This test verifies that the greeting follows the hour of the local time, and that the system provides it (greeter::tests::daytime_greeting_selection, environment::tests::system_environment)."
            verifies = [SwRequirements.sw_func_daytime_greeting_selection]
        }

        SwTestCase tc_greet_night_time_greeting {
            description = "This test verifies that the greeter returns 'Good night <name>!' when the time is between 19:00 and 04:59 (greeter::tests::night_time_greeting)."
            verifies = [SwRequirements.sw_func_night_time_greeting, SwRequirements.sw_func_daytime_greeting_selection]
        }

        SwTestCase tc_greet_morning_time_greeting {
            description = "This test verifies that the greeter returns 'Good morning <name>!' when the time is between 5:00 and 10:59 (greeter::tests::morning_time_greeting)."
            verifies = [SwRequirements.sw_func_morning_time_greeting, SwRequirements.sw_func_daytime_greeting_selection]
        }

        SwTestCase tc_greet_midday_time_greeting {
            description = "This test verifies that the greeter returns 'Good midday <name>!' when the time is between 11:00 and 12:59 (greeter::tests::midday_time_greeting)."
            verifies = [SwRequirements.sw_func_midday_time_greeting, SwRequirements.sw_func_daytime_greeting_selection]
        }

        SwTestCase tc_greet_afternoon_time_greeting {
            description = "This test verifies that the greeter returns 'Good afternoon <name>!' when the time is between 13:00 and 18:59 (greeter::tests::afternoon_time_greeting)."
            verifies = [SwRequirements.sw_func_afternoon_time_greeting, SwRequirements.sw_func_daytime_greeting_selection]
        }

        SwTestCase tc_greet_user_name {
            description = "This test verifies that the greeter uses the given user name (greeter::tests::user_name)."
            verifies = [SwRequirements.sw_req_cli_user_name]
        }

        SwTestCase tc_greet_default_name {
            description = "This test verifies that the greeter uses the login name without a user name, and that the system provides one (greeter::tests::default_name, environment::tests::system_environment)."
            verifies = [SwRequirements.sw_req_cli_default_name]
        }
    }
}
