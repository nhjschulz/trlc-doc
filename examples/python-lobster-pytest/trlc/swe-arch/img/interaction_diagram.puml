@startuml interaction_diagram

autoactivate on

participant "main" as main <<module>>
participant "greeter" as greeter <<module>>
participant "argparse" as argparse
participant "getpass" as getpass
participant "datetime" as datetime
participant "builtins" as builtins

autoactivate on

-> main: main()

    main -> argparse: parse arguments
    return

    main -> greeter: greet(name)
        opt name is None
            greeter -> getpass : getuser()
            return username
        end
        greeter -> datetime: now()
        return current time
        alt time between 5:00 am and 11:00 am
            greeter -> greeter: set greeting to "Good morning <USER>!"
            return
        else time between 11:00 am and 13:00 pm
            greeter -> greeter: set greeting to "Good midday <USER>!"
            return
        else time between 13:00 pm and 19:00 pm
            greeter -> greeter: set greeting to "Good afternoon <USER>!
            return
        else
            greeter -> greeter: set greeting to "Good night <USER>!"
            return
        end
    return greeting string

    main -> builtins : print(greeting)
    return

return status

@enduml