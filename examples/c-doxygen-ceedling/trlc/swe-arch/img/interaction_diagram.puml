@startuml interaction_diagram

autoactivate on

participant "main" as main <<module>>
participant "App" as app <<module>>
participant "Greeter" as greeter <<class>>
participant "getopt" as getopt <<module>>
participant "LocalTime" as localTime <<module>>
participant "getenv" as getenv <<module>>
participant "Printer" as printer <<module>>

autoactivate on

-> main: main()
    main -> app: App_run(argc, argv)

        app -> getopt: getopt_long(argc, argv, options, long_options)
        return optind

        loop for each argument
            app -> getopt: getopt_long()
            return optind
        end

        app -> greeter: Greeter_init(hourThresholdMorning, hourThresholdMidday, hourThresholdAfternoon, hourThresholdNight)
        return
        app -> app: handle command line arguments
            loop for each argument
                app -> getopt: getopt_long()
                return
            end
        return status

        app -> greeter: Greeter_greet(name)

            greeter -> localTime: LocalTime_time()
            return time information

            greeter -> localTime: LocalTime_localtime(time information)
            return local time information

            opt name is not provided
                greeter -> getenv : get login name
                return user name
            end

            alt time between 5:00 am and 11:00 am
                greeter -> greeter: set greeting to "Good morning <USER>!"
                return
            else time between 11:00 am and 13:00 pm
                greeter -> greeter: set greeting to "Good midday <USER>!"
                return
            else time between 13:00 pm and 19:00 pm
                greeter -> greeter: set greeting to "Good afternoon <USER>!
                return
            else
                greeter -> greeter: set greeting to "Good night <USER>!"
                return
            end

            greeter -> printer: Printer_printf(greeting)
            return

        return

    return status

return status

@enduml
