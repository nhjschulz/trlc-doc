# Doxygen configuration of the greeter sources, used twice by trlcdoc:
#
# - trace level "SW Code": trlcdoc runs doxygen with this file and only XML output,
#   lobster-doxygen extracts the @implements tags from it.
# - document "sw_detail_design": trlcdoc runs "doxygen Doxyfile" for the HTML pages.
#
# Both run in this folder, so the paths are relative to the project root.
# Settings not listed here have their doxygen default.

PROJECT_NAME           = Greeter
PROJECT_BRIEF          = "Detail design"
OUTPUT_DIRECTORY       = build/doxygen
QUIET                  = YES

INPUT                  = src doc/mainpage.md
FILE_PATTERNS          = *.cpp *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = doc/mainpage.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES

# The tags lobster-doxygen reads: @implements{<requirement>} and @justification{<reason>}.
ALIASES                = "implements{1}=@xrefitem implements \"Implements\" \"Requirement Traceability\" Requirement: \1" \
                         "justification{1}=@xrefitem justified \"Justified\" \"Justification Overview\" Justification: \1"

GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = NO
GENERATE_LATEX         = NO

# Class and call graphs need Graphviz, which PlantUML needs as well.
HAVE_DOT               = YES
CALL_GRAPH             = YES
