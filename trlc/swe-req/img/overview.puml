@startuml overview
skinparam componentStyle uml2
left to right direction


package "Project" {
    file "TRLC model and\nrecords (.rsl/.trlc)" as trlc
    file "PlantUML\ndiagrams (.puml)" as puml
    file "Sources and tests" as src
    file "Documents (.rst/.md)" as doc
}

rectangle "Tools" {
    component "LOBSTER"
    component "TRLC"
    component "PlantUML"
    component "Sphinx"
}
[trlcdoc] as trlcdoc <<tool>> #lightgreen



Database "HTML Documentation" as out #lightblue {
}


trlc --> trlcdoc
puml --> trlcdoc
src --> trlcdoc
doc --> trlcdoc

trlcdoc -l--> Tools :use
trlcdoc --> out :generate
@enduml
